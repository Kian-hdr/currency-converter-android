  <activity-alias android:name="${applicationId}.WhiconsLauncher" android:targetActivity="dev.kiankonrad.currencycalculator.MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/ic_converter_whicons" android:label="Currency Converter"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
 </application>
</manifest>