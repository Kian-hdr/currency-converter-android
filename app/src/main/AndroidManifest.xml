<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <queries><package android:name="com.whicons.iconpack"/></queries>
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
 <application android:theme="@style/AppTheme" android:icon="@mipmap/ic_launcher" android:label="Currency Converter" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
